generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          String         @default("admin")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  loginAttempts LoginAttempt[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  ip        String
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())
}

model AccountGroup {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  purpose     String    @default("multi")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  accounts    Account[]
}

model Account {
  id                 String         @id @default(cuid())
  phone              String         @unique
  firstName          String
  lastName           String?
  username           String?
  telegramId         String?
  status             String         @default("active")
  classification     String         @default("multi")
  healthScore        Int            @default(75)
  isPremium          Boolean        @default(false)
  dc                 Int            @default(4)
  estimatedAge       String?
  twoFA              Boolean        @default(false)
  groupId            String?
  group              AccountGroup?  @relation(fields: [groupId], references: [id])
  proxyId            String?
  proxy              Proxy?         @relation(fields: [proxyId], references: [id])
  dailyGatherLimit   Int            @default(500)
  dailyAddLimit      Int            @default(20)
  dailyDmLimit       Int            @default(30)
  dailyCampaignLimit Int            @default(25)
  usedGather         Int            @default(0)
  usedAdd            Int            @default(0)
  usedDm             Int            @default(0)
  usedCampaign       Int            @default(0)
  rotationPriority   String         @default("medium")
  allowGather        Boolean        @default(true)
  allowAdd           Boolean        @default(true)
  allowDm            Boolean        @default(true)
  allowCampaign      Boolean        @default(true)
  inRotation         Boolean        @default(true)
  workHoursEnabled   Boolean        @default(false)
  workFrom           String?
  workTo             String?
  lastUsedAt         DateTime?
  lastCheckedAt      DateTime?
  restrictedUntil    DateTime?
  sessionData        String?
  device             String?
  os                 String?
  appVersion         String?
  groupsJoined       Int            @default(0)
  floodWaitsWeek     Int            @default(0)
  bio                String?
  avatarColor        String         @default("#229ED9")
  addedAt            DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  activities         ActivityLog[]
  rotationSlots      RotationSlot[]
}

model ProxyGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  proxies     Proxy[]
}

model Proxy {
  id            String      @id @default(cuid())
  host          String
  port          Int
  type          String      @default("socks5")
  username      String?
  password      String?
  secret        String?
  country       String?
  city          String?
  status        String      @default("unknown")
  latencyMs     Int?
  failCount     Int         @default(0)
  lastCheckedAt DateTime?
  notes         String?
  groupId       String?
  group         ProxyGroup? @relation(fields: [groupId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  accounts      Account[]
}

model MemberFile {
  id           String   @id @default(cuid())
  name         String
  source       String
  sourceRef    String?
  membersCount Int      @default(0)
  status       String   @default("ready")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Job {
  id           String    @id @default(cuid())
  type         String
  status       String    @default("pending")
  title        String
  progress     Int       @default(0)
  total        Int       @default(0)
  successCount Int       @default(0)
  failCount    Int       @default(0)
  skipCount    Int       @default(0)
  currentItem  String?
  config       String    @default("{}")
  result       String?
  liveLog      String    @default("[]")
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Blacklist {
  id        String   @id @default(cuid())
  value     String
  kind      String   @default("user")
  reason    String?
  scope     String   @default("global")
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  type      String
  level     String   @default("info")
  message   String
  details   String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  type      String   @default("info")
  read      Boolean  @default(false)
  href      String?
  createdAt DateTime @default(now())
}

model Template {
  id        String   @id @default(cuid())
  kind      String
  name      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id           String    @id @default(cuid())
  kind         String
  name         String
  status       String    @default("draft")
  message      String
  targetsCount Int       @default(0)
  sentCount    Int       @default(0)
  failCount    Int       @default(0)
  scheduledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model RotationSettings {
  id                String   @id @default("default")
  mode              String   @default("smart")
  enabled           Boolean  @default(true)
  switchAfter       Int      @default(10)
  restAfter         Int      @default(20)
  restMinutes       Int      @default(20)
  dailyResetTime    String   @default("00:00")
  excludeRestricted Boolean  @default(true)
  excludeDead       Boolean  @default(true)
  excludeWarming    Boolean  @default(true)
  workFrom          String   @default("09:00")
  workTo            String   @default("23:00")
  updatedAt         DateTime @updatedAt
}

model RotationSlot {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order     Int
  state     String  @default("ready")
  usedToday Int     @default(0)
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model GroupDirectory {
  id          String   @id @default(cuid())
  title       String
  username    String?
  inviteLink  String?
  members     Int      @default(0)
  type        String   @default("public")
  notes       String?
  createdAt   DateTime @default(now())
}
